# Copy to .env and fill in your values. Never commit .env.

# --- the model --------------------------------------------------------------
# Google AI Studio's free tier: an API key from aistudio.google.com. Two
# models on the one key — each has its own free-tier quota, so when the
# primary is rate-limited or down the fallback answers. The trace shows
# which model answered. Leave the fallback blank to have none.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite,gemini-flash-lite-latest,gemma-4-26b-a4b-it

# Optional: mirror complaints and leave requests (never a leave's reason) to
# GitHub Issues (app/tracker.py).
# Use a PRIVATE repository, and a fine-grained token scoped to that one repo
# with "Issues: Read and write" and nothing else. Off unless both are set.
# GITHUB_REPO=your-name/compass-facilities
# GITHUB_TOKEN=github_pat_...

# Optional tuning. The defaults in app/config.py should not need changing.
# LLM_TIMEOUT=12
# LLM_HEDGE_SECONDS=4      # ask the fallback too when the primary is this slow; 0 = off
# LLM_CONNECT_TIMEOUT=15
# LLM_KEEPALIVE=600

# --- records ----------------------------------------------------------------
# postgres | json. json needs no setup and is the fallback if the database
# is unreachable: flip this and restart, and everything keeps working.
RECORD_BACKEND=json
# docker compose up -d   then   python scripts/seed_db.py
DATABASE_URL=postgresql+psycopg://compass:compass@localhost:5433/compass

# --- retrieval --------------------------------------------------------------
# Embeddings are local (all-MiniLM-L6-v2 on ONNX). Rebuild after ANY edit to
# docs/regulations/:   python scripts/index_docs.py
# CHROMA_PATH=./data/chroma

# --- the domain -------------------------------------------------------------
# These must match the college's actual regulations.
ATTENDANCE_THRESHOLD=0.75
PERIODS_PER_DAY=6
OD_IS_CONDONED=true

# --- sessions ---------------------------------------------------------------
# The HMAC key for session cookies. Left unset, one is generated on first
# run and persisted to data/.session_secret (gitignored).
# COMPASS_SESSION_SECRET=
# COMPASS_SESSION_TTL=28800

# --- testing ----------------------------------------------------------------
# Pins what Compass believes today is, so calendar behaviour can be tested on
# any date. It warns on stderr whenever set. Never set it for a real run.
#   COMPASS_TODAY=2026-11-16 python scripts/run_acceptance.py
