# Copy to .env and fill in your values. Never commit .env.

# --- the model --------------------------------------------------------------
# Two free providers; at least one key is needed for chat. The primary is
# tried first and the other answers only when the primary is rate-limited,
# down, or rejects the key. The trace shows which one answered.
LLM_PRIMARY=github

# GitHub Models: a personal access token with the `models:read` permission
# (fine-grained PAT -> Account permissions -> Models: read-only).
GITHUB_MODELS_TOKEN=
# GITHUB_MODELS_MODEL=openai/gpt-4o-mini

# Google AI Studio: an API key from aistudio.google.com.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Optional tuning. The defaults in app/config.py should not need changing.
# LLM_TIMEOUT=30
# LLM_CONNECT_TIMEOUT=15
# LLM_KEEPALIVE=600

# --- records ----------------------------------------------------------------
# postgres | json. json needs no setup and is the fallback if the database
# is unreachable: flip this and restart, and everything keeps working.
RECORD_BACKEND=json
# docker compose up -d   then   python scripts/seed_db.py
DATABASE_URL=postgresql+psycopg://compass:compass@localhost:5432/compass

# --- retrieval --------------------------------------------------------------
# Embeddings are local (all-MiniLM-L6-v2 on ONNX). Rebuild after ANY edit to
# docs/regulations/:   python scripts/index_docs.py
# CHROMA_PATH=./data/chroma

# --- the domain -------------------------------------------------------------
# These must match the college's actual regulations.
ATTENDANCE_THRESHOLD=0.75
PERIODS_PER_DAY=6
OD_IS_CONDONED=true

# --- sessions ---------------------------------------------------------------
# The HMAC key for session cookies. Left unset, one is generated on first
# run and persisted to data/.session_secret (gitignored).
# COMPASS_SESSION_SECRET=
# COMPASS_SESSION_TTL=28800

# --- testing ----------------------------------------------------------------
# Pins what Compass believes today is, so calendar behaviour can be tested on
# any date. It warns on stderr whenever set. Never set it for a real run.
#   COMPASS_TODAY=2026-11-16 python scripts/run_acceptance.py
